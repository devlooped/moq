<Project>
  <PropertyGroup>
    <Product>Moq</Product>
    <ImplicitUsings>true</ImplicitUsings>
    <Authors>kzu</Authors>

    <!-- CodeAnalysis.Analyzers 3.11 adds every .resx as an AdditionalFile and
         blanks ThisAssembly.Strings' SourceItemType, so the strings generator emits nothing. -->
    <SkipAddAllResxFilesAsAdditionalFiles>true</SkipAddAllResxFilesAsAdditionalFiles>
    <TypeNameFormatterInternal>false</TypeNameFormatterInternal>
    <PackOnBuild Condition="'$(PackOnBuild)' == ''">$(CI)</PackOnBuild>

    <!-- NoTargets/Traversal projects do not support central package versions. -->
    <ManagePackageVersionsCentrally Condition="'$(MSBuildProjectExtension)' != '.csproj' and '$(MSBuildProjectExtension)' != '.vbproj'">false</ManagePackageVersionsCentrally>

    <RestoreAdditionalProjectSources>https://kzu.blob.core.windows.net/nuget/index.json;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)..\..\nugetizer\bin\')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\nugetizer\bin'));$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)..\..\stunts\bin\')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\stunts\bin'));$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
    <RestoreAdditionalProjectSources Condition="Exists('$(MSBuildThisFileDirectory)..\..\ThisAssembly\bin\')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\ThisAssembly\bin'));$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>

    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Moq.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
    <PublicKeyToken>69f491c39445e920</PublicKeyToken>
    <SignAssembly>true</SignAssembly>

    <!-- Checked-in resx designers use the full project name (Moq.CodeFixes.Resources).
         The shared props shorten RootNamespace to its first segment, which embeds those
         resources as Moq.Resources and breaks ThisAssembly and the designer lookup. -->
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" Visible="false" />
    <PackageReference Include="ThisAssembly" PrivateAssets="all" Visible="false" />
  </ItemGroup>

  <!-- Packaging projects resolve references via dotnet-nugetize, which calls GetTargetPath. -->
  <Target Name="GetTargetPath" DependsOnTargets="_SetGetTargetPathInnerTarget;DispatchToInnerBuilds" />
  <Target Name="_SetGetTargetPathInnerTarget" Returns="@(InnerOutput)">
    <PropertyGroup Condition="'$(InnerTargets)' == ''">
      <InnerTargets>GetTargetPath</InnerTargets>
    </PropertyGroup>
  </Target>
</Project>
