<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Moq</RootNamespace>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackFolder>tools\$(TargetFramework)</PackFolder>
    <!-- RS1042: ISourceGenerator is obsolete in the Roslyn 4.14 reference but still what this generator implements. -->
    <!-- RS1035: The symbol 'GeneratorExecutionContext' is banned for use by analyzers: Non-incremental source generators should not be used, implement IIncrementalGenerator instead -->
    <NoWarn>$(NoWarn);RS1042;RS1035</NoWarn>
    <!-- The generator runs in csc, which does not load the workspace or editor features. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS1038</WarningsAsErrors>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGetizer" PrivateAssets="all" />
    <PackageReference Include="Stunts.StaticProxy" Pack="false" />
    <PackageReference Include="Stunts.CodeAnalysis" Pack="false" />

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Pack="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Pack="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Pack="false" />

    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Pack="false" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moq.Sdk\Moq.Sdk.csproj" Pack="false" />
  </ItemGroup>

  <!-- Replaced by common targets, required for the multitargeting DependsOnTargets below -->
  <Target Name="ResolveReferences" />
  <Target Name="AddDependencies" Condition="'$(IsPackable)' != 'true'" AfterTargets="Build" BeforeTargets="GetPackageContents" DependsOnTargets="ResolveReferences">
    <ItemGroup Condition="'$(TargetFramework)' != ''">
      <AnalyzerFile Include="@(ReferenceCopyLocalPaths)"
                    Condition="'%(ReferenceCopyLocalPaths.AssetType)' != 'resources'
                               and '%(Filename)' != 'Microsoft.CodeAnalysis'
                               and '%(Filename)' != 'Microsoft.CodeAnalysis.CSharp'" />
      <PackageFile Include="@(AnalyzerFile -> '%(FullPath)')" PackagePath="tools\$(TargetFramework)\%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
