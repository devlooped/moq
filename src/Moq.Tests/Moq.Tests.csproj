<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <Nullable>annotations</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.console" />
    <PackageReference Include="xunit.runner.msbuild" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="ManualStunts" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Mocks\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DelegateMocksTests.cs" />
    <Compile Remove="LegacyTests.cs" />
    <!-- Migrated to the typed setups API in a later stage. -->
    <Compile Remove="CallBaseTests.cs;MoqTests.cs;MoqTTests.cs;RecursiveMocksTests.cs;RefOutTests.cs;VerificationTests.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="..\Moq.Package\Mock.cs" Link="Moq\Mock.cs" />
    <Compile Include="..\Moq.Package\Mock.Overloads.cs" Link="Moq\Mock.Overloads.cs" />
    <Compile Include="..\Moq.DynamicProxy\Mock.DynamicFactory.cs" Link="Moq\Mock.DynamicFactory.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="DelegateMocksTests.cs" />
    <None Include="LegacyTests.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Moq.DynamicProxy\Moq.DynamicProxy.csproj" />
    <ProjectReference Include="..\Moq.Sdk\Moq.Sdk.csproj" />
    <ProjectReference Include="..\Moq\Moq.csproj" />
    <ProjectReference Include="..\Moq.CodeAnalysis\Moq.CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
    
</Project>