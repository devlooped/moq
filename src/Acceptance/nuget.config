<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Forward slashes so Linux resolves this relative to the config file.
         Backslashes stay literal, the source is renamed to that path, and the
         "local" package source mapping no longer applies. -->
    <add key="local" value="../../bin" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <!-- Always test the package just packed from this repository. -->
    <packageSource key="local">
      <package pattern="Moq" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
