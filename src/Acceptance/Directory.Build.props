<Project TreatAsLocalProperty="VersionSuffix">
  <Import Project="..\Directory.Build.props" />
  <PropertyGroup>
    <!-- Isolates the locally packed Moq from the global packages folder. Delete it to restore a newly packed Moq with the same version. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory).nuget\packages</RestorePackagesPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
