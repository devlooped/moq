<Project>
  <!-- Prevent importing the shared targets. Still apply the net10-only non-Windows policy. -->
  <Import Project="..\Directory.targets" Condition="Exists('..\Directory.targets')" />

  <ItemGroup>
    <!-- The package just packed from this repository, restored from ../../bin. -->
    <PackageVersion Include="Moq" Version="$(Version)" />
  </ItemGroup>
</Project>
